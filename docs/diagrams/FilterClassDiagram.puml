@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
Class FilterCommandParser
Class FilterCommand
}

package Model as ModelPackage {
Class "<<interface>>\nPredicate<Person>" as Predicate MODEL_COLOR
Class StudentMatchesAllPredicate MODEL_COLOR
Class NameContainsKeywordsPredicate MODEL_COLOR
Class SchoolContainsTextPredicate MODEL_COLOR
Class LevelMatchesPredicate MODEL_COLOR
Class SubjectMatchesPredicate MODEL_COLOR
Class PhoneMatchesPredicate MODEL_COLOR
Class EmailContainsTextPredicate MODEL_COLOR
Class GuardianNameContainsTextPredicate MODEL_COLOR
Class GuardianPhoneMatchesPredicate MODEL_COLOR
Class NoteContainsTextPredicate MODEL_COLOR
}

FilterCommandParser ..> FilterCommand : <<create>>
FilterCommandParser ..> StudentMatchesAllPredicate : <<create>>
FilterCommand --> "1" StudentMatchesAllPredicate

StudentMatchesAllPredicate ..|> Predicate
StudentMatchesAllPredicate --> "1..*" Predicate : filters

NameContainsKeywordsPredicate .up.|> Predicate
SchoolContainsTextPredicate .up.|> Predicate
LevelMatchesPredicate .up.|> Predicate
SubjectMatchesPredicate .up.|> Predicate
PhoneMatchesPredicate .up.|> Predicate
EmailContainsTextPredicate .up.|> Predicate
GuardianNameContainsTextPredicate .up.|> Predicate
GuardianPhoneMatchesPredicate .up.|> Predicate
NoteContainsTextPredicate .up.|> Predicate
@enduml
