@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
participant ":ResultDisplay" as ResultDisplay UI_COLOR
participant ":StudentDetailPanel" as StudentDetailPanel UI_COLOR
participant ":PersonListPanel" as PersonListPanel UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":Logic" as Logic LOGIC_COLOR
end box

[-> MainWindow : executeCommand("view 1")
activate MainWindow

MainWindow -> Logic : execute("view 1")
activate Logic
Logic --> MainWindow : result
deactivate Logic

MainWindow -> ResultDisplay : setFeedbackToUser(...)
activate ResultDisplay
ResultDisplay --> MainWindow
deactivate ResultDisplay

MainWindow -> MainWindow : updateMainContent(result)
activate MainWindow

note right of MainWindow
person and index are
read from result.
end note

MainWindow -> Logic : getFilteredPersonList()
activate Logic
Logic --> MainWindow : persons
deactivate Logic

create StudentDetailPanel
MainWindow -> StudentDetailPanel : StudentDetailPanel(person, index, persons)
activate StudentDetailPanel
StudentDetailPanel --> MainWindow
deactivate StudentDetailPanel

MainWindow -> MainWindow : show panel in detail area
activate MainWindow
MainWindow --> MainWindow
deactivate MainWindow

MainWindow -> PersonListPanel : highlightPerson(person)
activate PersonListPanel
PersonListPanel --> MainWindow
deactivate PersonListPanel

MainWindow --> MainWindow
deactivate MainWindow

[<-- MainWindow : result
deactivate MainWindow
@enduml
