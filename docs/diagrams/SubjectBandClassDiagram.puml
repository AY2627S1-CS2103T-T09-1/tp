@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>> {
    Class Person
    Class Subject
    Class "<<enumeration>>\nBand" as Band
}

Person "1" *--> "1..8" Subject : subjects
Subject --> "1" Band : band

note bottom of Band
  G1
  G2
  G3
end note
@enduml
