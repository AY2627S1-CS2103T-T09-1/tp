<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Orientation?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.58" orientation="VERTICAL" styleClass="student-detail-split-pane"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <items>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="student-detail-scroll-pane">
      <VBox spacing="16" styleClass="student-detail-panel">
        <padding>
          <Insets top="20" right="20" bottom="20" left="20" />
        </padding>
        <Label fx:id="studentIndex" styleClass="student-detail-heading" wrapText="true" />
        <GridPane hgap="20" vgap="14">
          <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="90">
              <maxWidth>
                <Region fx:constant="USE_PREF_SIZE" />
              </maxWidth>
            </ColumnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="100" />
          </columnConstraints>
          <Label styleClass="student-detail-field-name" text="Name" GridPane.rowIndex="0" />
          <Label fx:id="name" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="0" />
          <Label styleClass="student-detail-field-name" text="Student phone" GridPane.rowIndex="1" />
          <Label fx:id="phone" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="1" />
          <Label styleClass="student-detail-field-name" text="School" GridPane.rowIndex="2" />
          <Label fx:id="school" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="2" />
          <Label styleClass="student-detail-field-name" text="Level" GridPane.rowIndex="3" />
          <Label fx:id="level" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="3" />
          <Label styleClass="student-detail-field-name" text="Subjects and bands" GridPane.rowIndex="4" />
          <Label fx:id="subjects" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="4" />
          <Label styleClass="student-detail-field-name" text="Guardian name" GridPane.rowIndex="5" />
          <Label fx:id="guardianName" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="5" />
          <Label styleClass="student-detail-field-name" text="Guardian phone" GridPane.rowIndex="6" />
          <Label fx:id="guardianPhone" styleClass="student-detail-field-value" wrapText="true"
                 GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </GridPane>
      </VBox>
    </ScrollPane>
    <VBox minHeight="140" spacing="12" styleClass="student-detail-notes-panel">
      <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
      </padding>
      <Label styleClass="student-detail-notes-heading" text="Notes" />
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" VBox.vgrow="ALWAYS"
                  styleClass="student-detail-notes-scroll-pane">
        <VBox fx:id="noteCards" fillWidth="true" spacing="10" />
      </ScrollPane>
    </VBox>
  </items>
</SplitPane>
