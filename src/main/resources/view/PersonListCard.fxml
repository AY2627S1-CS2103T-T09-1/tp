<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" maxWidth="Infinity" minHeight="75" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="12" right="14" bottom="12" left="18" />
    </padding>
    <HBox spacing="0.5" alignment="TOP_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" maxWidth="Infinity" text="\$first" styleClass="cell_big_label"
             wrapText="true" HBox.hgrow="ALWAYS" />
    </HBox>
    <Label fx:id="phone" maxWidth="Infinity" styleClass="cell_small_label" text="\$phone"
           wrapText="true" />
    <Label fx:id="school" maxWidth="Infinity" styleClass="cell_small_label" text="\$school"
           wrapText="true" />
    <Label fx:id="address" maxWidth="Infinity" styleClass="cell_small_label"
           wrapText="true" />
    <Label fx:id="level" maxWidth="Infinity" styleClass="cell_small_label" text="\$level"
           wrapText="true" />
  </VBox>
</HBox>
